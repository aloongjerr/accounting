{
    "name": "aloongjerr/accounting",
    "description": "A comprehensive filament accounting package.",
    "keywords": [
        "aloongjerr",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "accounting"
    ],
    "homepage": "https://github.com/aloongjerr/accounting",
    "support": {
        "issues": "https://github.com/aloongjerr/accounting/issues",
        "source": "https://github.com/aloongjerr/accounting"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Asyraf Othman",
            "email": "creathink.idea@gmail.com",
            "role": "Fullstack Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AloongJerr\\Accounting\\": "src/",
            "AloongJerr\\Accounting\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AloongJerr\\Accounting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AloongJerr\\Accounting\\AccountingServiceProvider"
            ],
            "aliases": {
                "Accounting": "AloongJerr\\Accounting\\Facades\\Accounting"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
